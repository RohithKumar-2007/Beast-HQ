# BEAST HQ Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Production Frontend Origin (e.g. deployed Vercel URL)
FRONTEND_ORIGIN=http://localhost:5173
# Production Example: FRONTEND_ORIGIN=https://<your-vercel-app>.vercel.app

# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/beast-hq
# Production Example: MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/beast-hq?retryWrites=true&w=majority
